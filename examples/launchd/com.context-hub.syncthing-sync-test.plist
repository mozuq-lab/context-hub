<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.context-hub.syncthing-sync-test</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SYNCTHING_BIN__</string>
    <string>serve</string>
    <string>--home</string>
    <string>__SYNCTHING_PROFILE_PATH__</string>
    <string>--no-browser</string>
    <string>--no-restart</string>
    <string>--no-upgrade</string>
    <string>--log-file</string>
    <string>__SYNCTHING_PROFILE_PATH__/syncthing.log</string>
    <string>--log-max-old-files</string>
    <string>3</string>
    <string>--log-max-size</string>
    <string>5242880</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
