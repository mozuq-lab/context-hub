{
  "schema_version": 1,
  "hubConfigPath": "/path/to/settings/context-hub.json",
  "installDir": "/path/to/context-hub-installation",
  "previousRuntimePath": "/path/to/context-hub-checkout",
  "openclaw": {
    "executable": "/path/to/openclaw",
    "configPath": "/path/to/settings/openclaw.json",
    "gatewayPlist": "/path/to/LaunchAgents/ai.openclaw.gateway.plist",
    "automationId": "REPLACE_WITH_EXISTING_JOB_ID"
