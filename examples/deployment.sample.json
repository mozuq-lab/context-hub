  "launchd": {
    "syncPlist": "/path/to/LaunchAgents/com.context-hub.syncthing.plist",
    "backupPlist": "/path/to/LaunchAgents/com.context-hub.vault-backup.plist",
    "backupVerifyPlist": null
  },
  "workspacePath": "/path/to/openclaw/workspace-hub",
  "preserveAssets": []
}
